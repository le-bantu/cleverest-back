# --- Application ---
NODE_ENV=test
PORT=3000
API_PREFIX=api

# --- Database ---
DATABASE_URL=postgresql://cleverest:cleverest@localhost:5433/cleverest_test?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

# --- OTP / 2FA ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mail ---
MAIL_DRIVER=log
MAIL_FROM=no-reply@cleverest.local

# --- Seed ---
SEED_SUPERADMIN_EMAIL=superadmin@cleverest.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026

# --- Security (tests log in dozens of times per minute from 127.0.0.1) ---
RATE_LIMIT_PER_MINUTE=100000
AUTH_RATE_LIMIT_PER_MINUTE=100000
