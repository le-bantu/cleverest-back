// Cleverest — single schema, single database.
// Bounded-context isolation is applicative (folders + no cross-module repo imports),
// not physical. LOT 1 introduces the identity-access + shared tables only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// identity-access
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String?   @unique
  phone            String?
  passwordHash     String
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  clientProfile     ClientProfile?
  consultantProfile ConsultantProfile?
  adminProfile      AdminProfile?
  apporteurProfile  ApporteurProfile?

  roles         UserRole[]
  permissions   UserPermission[]
  otpChallenges OtpChallenge[]
  refreshTokens RefreshToken[]
  notifications Notification[]

  quotesAsClient      Quote[]                   @relation("QuoteClient")
  quotesQuoted        Quote[]                   @relation("QuoteQuotedBy")
  quoteAssignments    QuoteConsultant[]
  quoteDocuments      QuoteDocument[]
  quoteDocumentGrants QuoteDocumentVisibility[]

  contractsAsClient   Contract[]           @relation("ContractClient")
  consultantContracts ConsultantContract[] @relation("ConsultantContractConsultant")

  missionsAsClient   Mission[]           @relation("MissionClient")
  missionAssignments MissionConsultant[]
  missionTasks       MissionTask[]

  deliverablesAuthored Deliverable[] @relation("DeliverableConsultant")
  deliverablesReceived Deliverable[] @relation("DeliverableClient")

  payments           Payment[]           @relation("PaymentClient")
  clientInvoices     ClientInvoice[]     @relation("ClientInvoiceClient")
  consultantInvoices ConsultantInvoice[] @relation("ConsultantInvoiceConsultant")

  @@index([isActive])
  @@map("users")
}

model ClientProfile {
  userId              String    @id @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String?
  companySize         String?
  taxId               String?
  activityType        String?
  averageRevenue      Decimal?  @db.Decimal(14, 2)
  companyCreationDate DateTime?
  rib                 String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("client_profiles")
}

model ConsultantProfile {
  userId                String   @id @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String?
  lastName              String?
  phone                 String?
  email                 String?
  isCompany             Boolean  @default(false)
  taxId                 String?
  expertiseDomains      String[] @default([])
  experience            String?
  billingEntity         String?
  hasAcceptedConditions Boolean  @default(false)
  consultingContractUrl String?
  rib                   String?
  validated             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([validated])
  @@map("consultant_profiles")
}

model AdminProfile {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_profiles")
}

model ApporteurProfile {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  structure String?
  documents String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("apporteur_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String     @db.Uuid
  permissionId String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

enum OtpChannel {
  EMAIL
}

enum OtpPurpose {
  LOGIN
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  channel    OtpChannel @default(EMAIL)
  purpose    OtpPurpose @default(LOGIN)
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, consumedAt])
  @@map("otp_challenges")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// quotes
// ---------------------------------------------------------------------------

// DB values keep the legacy accents (CDC §7.5); the TS identifiers are ASCII.
enum QuoteStatus {
  EN_ATTENTE
  TRAITEMENT_CONSULTANT
  COTE                  @map("COTÉ")
  VALIDE_ADMIN          @map("VALIDÉ_ADMIN")
  SIGNE_CLIENT          @map("SIGNÉ_CLIENT")
  REJETE                @map("REJETÉ")
  A_REVOIR_CONSULTANT
  A_REVOIR_CLIENT
}

enum QuoteType {
  CONSULTATION
  ABONNEMENT
}

enum QuoteActorRole {
  CLIENT
  CONSULTANT
  ADMIN
}

enum DocumentVisibleTo {
  ALL
  ADMIN
  CONSULTANT
  CLIENT
  SPECIFIC
}

model Quote {
  id                     String      @id @default(uuid()) @db.Uuid
  clientId               String      @db.Uuid
  client                 User        @relation("QuoteClient", fields: [clientId], references: [id], onDelete: Restrict)
  parentQuoteId          String?     @db.Uuid
  parentQuote            Quote?      @relation("QuoteSubquotes", fields: [parentQuoteId], references: [id], onDelete: Cascade)
  subquotes              Quote[]     @relation("QuoteSubquotes")
  isSubquote             Boolean     @default(false)
  requestNumber          String      @unique
  type                   QuoteType
  title                  String?
  description            String
  price                  Decimal?    @db.Decimal(14, 2)
  currency               String      @default("EUR")
  status                 QuoteStatus @default(EN_ATTENTE)
  adminNotes             String?
  adminNotesToConsultant String?
  adminNotesToClient     String?
  consultantNotes        String?
  rejectedReason         String?
  quotedById             String?     @db.Uuid
  quotedBy               User?       @relation("QuoteQuotedBy", fields: [quotedById], references: [id], onDelete: SetNull)
  submittedAt            DateTime?
  validatedAt            DateTime?
  adminDeadline          DateTime?
  consultantDeadline     DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  consultants QuoteConsultant[]
  documents   QuoteDocument[]
  contract    Contract?
  missions    Mission[]

  consultantContracts     ConsultantContract[] @relation("ConsultantContractQuote")
  consultantContractsRoot ConsultantContract[] @relation("ConsultantContractRootQuote")

  @@index([clientId])
  @@index([status])
  @@index([parentQuoteId])
  @@index([createdAt])
  @@map("quotes")
}

/// Pivot devis ↔ consultant (users.id). At most one lead per quote (partial unique index in SQL).
model QuoteConsultant {
  quoteId      String   @db.Uuid
  consultantId String   @db.Uuid
  isLead       Boolean  @default(false)
  assignedAt   DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  consultant   User     @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@id([quoteId, consultantId])
  @@index([consultantId])
  @@map("quote_consultants")
}

model QuoteDocument {
  id             String            @id @default(uuid()) @db.Uuid
  quoteId        String            @db.Uuid
  quote          Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedById   String            @db.Uuid
  uploadedBy     User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedByRole QuoteActorRole
  label          String?
  path           String
  originalName   String
  mimeType       String?
  size           Int
  comment        String?
  visibleTo      DocumentVisibleTo
  createdAt      DateTime          @default(now())

  visibleUsers QuoteDocumentVisibility[]

  @@index([quoteId])
  @@map("quote_documents")
}

/// Users granted access to a document whose visibleTo = SPECIFIC.
model QuoteDocumentVisibility {
  documentId String        @db.Uuid
  userId     String        @db.Uuid
  document   QuoteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@map("quote_document_visibilities")
}

// ---------------------------------------------------------------------------
// contracts
// ---------------------------------------------------------------------------

/// One contract per quote; signed once by the client (mono-signature).
model Contract {
  id               String    @id @default(uuid()) @db.Uuid
  quoteId          String    @unique @db.Uuid
  quote            Quote     @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  /// owner of the quote, captured at creation
  clientId         String    @db.Uuid
  client           User      @relation("ContractClient", fields: [clientId], references: [id], onDelete: Restrict)
  createdById      String?   @db.Uuid
  originalFileKey  String
  originalFileName String
  originalMimeType String?
  originalSize     Int
  signedFileKey    String?
  signedFileName   String?
  signedMimeType   String?
  signedSize       Int?
  signed           Boolean   @default(false)
  signedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  missions Mission[]

  @@index([clientId])
  @@index([signed])
  @@index([createdAt])
  @@map("contracts")
}

/// Engagement Cleverest ↔ ONE consultant, backed by the quote the consultant priced
/// (a subquote, or the main quote when it was not split). Distinct from `Contract` (client).
model ConsultantContract {
  id               String    @id @default(uuid()) @db.Uuid
  quoteId          String    @db.Uuid
  quote            Quote     @relation("ConsultantContractQuote", fields: [quoteId], references: [id], onDelete: Restrict)
  /// main quote (= quoteId, or the parent of a subquote) — links the engagement to the mission
  rootQuoteId      String    @db.Uuid
  rootQuote        Quote     @relation("ConsultantContractRootQuote", fields: [rootQuoteId], references: [id], onDelete: Restrict)
  consultantId     String    @db.Uuid
  consultant       User      @relation("ConsultantContractConsultant", fields: [consultantId], references: [id], onDelete: Restrict)
  amount           Decimal   @db.Decimal(14, 2)
  currency         String    @default("EUR")
  createdById      String?   @db.Uuid
  originalFileKey  String
  originalFileName String
  originalMimeType String?
  originalSize     Int
  signedFileKey    String?
  signedFileName   String?
  signedMimeType   String?
  signedSize       Int?
  signedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([quoteId, consultantId])
  @@index([consultantId, rootQuoteId])
  @@index([rootQuoteId])
  @@map("consultant_contracts")
}

// ---------------------------------------------------------------------------
// missions
// ---------------------------------------------------------------------------

enum MissionStatus {
  EN_ATTENTE
  EN_COURS
  EN_VALIDATION
  TERMINEE      @map("TERMINÉE")
  REJETEE       @map("REJETÉE")
}

enum MissionTaskStatus {
  A_FAIRE
  EN_COURS
  FAITE
}

model Mission {
  id               String        @id @default(uuid()) @db.Uuid
  contractId       String        @db.Uuid
  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// captured from the contract at creation
  quoteId          String        @db.Uuid
  quote            Quote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  clientId         String        @db.Uuid
  client           User          @relation("MissionClient", fields: [clientId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  status           MissionStatus @default(EN_ATTENTE)
  /// 0-100; computed from tasks when the mission has any
  progress         Int           @default(0)
  deliveryDate     DateTime?
  contractFileKey  String?
  contractFileName String?
  contractMimeType String?
  contractSize     Int?
  createdById      String?       @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  consultants  MissionConsultant[]
  tasks        MissionTask[]
  deliverables Deliverable[]

  payments           Payment[]
  clientInvoices     ClientInvoice[]
  consultantInvoices ConsultantInvoice[]

  @@index([contractId])
  @@index([clientId])
  @@index([status])
  @@index([deliveryDate])
  @@map("missions")
}

/// Pivot mission ↔ consultant. At most one lead per mission (partial unique index in SQL).
model MissionConsultant {
  missionId    String   @db.Uuid
  consultantId String   @db.Uuid
  isLead       Boolean  @default(false)
  assignedAt   DateTime @default(now())
  mission      Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  consultant   User     @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@id([missionId, consultantId])
  @@index([consultantId])
  @@map("mission_consultants")
}

model MissionTask {
  id                   String            @id @default(uuid()) @db.Uuid
  missionId            String            @db.Uuid
  mission              Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  order                Int
  status               MissionTaskStatus @default(A_FAIRE)
  assigneeConsultantId String?           @db.Uuid
  assignee             User?             @relation(fields: [assigneeConsultantId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([missionId, order])
  @@map("mission_tasks")
}

// ---------------------------------------------------------------------------
// deliverables
// ---------------------------------------------------------------------------

/// Visible to the client only once adminValidated (enforced in the domain).
model Deliverable {
  id                 String    @id @default(uuid()) @db.Uuid
  missionId          String    @db.Uuid
  mission            Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  consultantId       String    @db.Uuid
  consultant         User      @relation("DeliverableConsultant", fields: [consultantId], references: [id], onDelete: Restrict)
  /// owner of the mission, captured at upload
  clientId           String    @db.Uuid
  client             User      @relation("DeliverableClient", fields: [clientId], references: [id], onDelete: Restrict)
  fileKey            String
  originalName       String
  mimeType           String?
  size               Int
  uploadedAt         DateTime  @default(now())
  clientValidated    Boolean   @default(false)
  clientValidatedAt  DateTime?
  adminValidated     Boolean   @default(false)
  adminValidatedAt   DateTime?
  adminValidatedById String?   @db.Uuid

  @@index([missionId])
  @@index([consultantId])
  @@index([clientId, adminValidated])
  @@index([uploadedAt])
  @@map("deliverables")
}

// ---------------------------------------------------------------------------
// shared
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entity     String
  entityId   String
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// payments (+ client invoices) & consultant invoices
// ---------------------------------------------------------------------------

/// Payment DECLARED by the client (transfer proof). Validated once by an admin.
model Payment {
  id            String    @id @default(uuid()) @db.Uuid
  missionId     String    @db.Uuid
  mission       Mission   @relation(fields: [missionId], references: [id], onDelete: Restrict)
  /// owner of the mission, captured at submission
  clientId      String    @db.Uuid
  client        User      @relation("PaymentClient", fields: [clientId], references: [id], onDelete: Restrict)
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("EUR")
  proofFileKey  String
  proofFileName String
  proofMimeType String?
  proofSize     Int
  validatedAt   DateTime?
  validatedById String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoice ClientInvoice?

  @@index([missionId])
  @@index([clientId])
  @@index([validatedAt])
  @@index([createdAt])
  @@map("payments")
}

/// Invoice issued by Cleverest to the client for a validated payment (generated PDF).
model ClientInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  paymentId     String    @unique @db.Uuid
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  missionId     String    @db.Uuid
  mission       Mission   @relation(fields: [missionId], references: [id], onDelete: Restrict)
  clientId      String    @db.Uuid
  client        User      @relation("ClientInvoiceClient", fields: [clientId], references: [id], onDelete: Restrict)
  /// FAC-<year>-<seq>, sequential per year
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("EUR")
  pdfFileKey    String
  pdfFileName   String
  pdfSize       Int
  generatedAt   DateTime
  generatedById String?   @db.Uuid
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([missionId])
  @@map("client_invoices")
}

/// Invoice a consultant sends to Cleverest for a mission, capped by their signed consultant contract(s).
model ConsultantInvoice {
  id           String    @id @default(uuid()) @db.Uuid
  consultantId String    @db.Uuid
  consultant   User      @relation("ConsultantInvoiceConsultant", fields: [consultantId], references: [id], onDelete: Restrict)
  missionId    String    @db.Uuid
  mission      Mission   @relation(fields: [missionId], references: [id], onDelete: Restrict)
  /// main quote of the mission (the engagement cap is per consultant and main quote)
  quoteId      String    @db.Uuid
  amount       Decimal   @db.Decimal(14, 2)
  currency     String    @default("EUR")
  fileKey      String
  fileName     String
  mimeType     String?
  size         Int
  uploadedAt   DateTime
  paidAt       DateTime?
  paidById     String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([consultantId, quoteId])
  @@index([missionId])
  @@index([paidAt])
  @@index([uploadedAt])
  @@map("consultant_invoices")
}
