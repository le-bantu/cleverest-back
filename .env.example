# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Database ---
DATABASE_URL=postgresql://cleverest:cleverest@localhost:5442/cleverest?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=30d

# --- OTP / 2FA ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mail ---
MAIL_DRIVER=log
MAIL_FROM=no-reply@cleverest.local

# --- Seed ---
SEED_SUPERADMIN_EMAIL=superadmin@cleverest.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026

# --- Security ---
# comma-separated front-end origins (empty = no CORS)
CORS_ORIGINS=http://localhost:4200
# number of reverse proxies in front of the app (for the client IP used by rate limiting)
TRUST_PROXY=0
# Swagger UI at /api/docs (defaults to off when NODE_ENV=production)
# SWAGGER_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
